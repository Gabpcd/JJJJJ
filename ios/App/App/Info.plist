<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>Jolene</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Jolene utilise votre position pour valider votre pointage à l'arrivée et au départ de vos missions.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Jolene enregistre votre position pendant vos missions (option facultative) pour fiabiliser le pointage et faciliter la résolution de litiges. Données conservées 30 jours puis supprimées.</string>
	<key>NSCameraUsageDescription</key>
	<string>Jolene utilise la caméra pour photographier vos documents professionnels (diplômes, pièce d'identité, RCP).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Jolene accède à vos photos pour téléverser vos documents professionnels.</string>
	<key>NSLocalNotificationUsageDescription</key>
	<string>Jolene vous envoie des rappels pour vos missions (début, pointage, paiement).</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Jolene enregistre vos justificatifs téléchargés (avoirs, certificats) dans votre photothèque.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Jolene utilise Face ID ou Touch ID pour sécuriser la connexion à votre compte.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
