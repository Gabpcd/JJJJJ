// Socle commun des deux schemes. Identité store reprise à l'identique de ios/App (décision 2).
PRODUCT_BUNDLE_IDENTIFIER = app.jolene
DEVELOPMENT_TEAM = GDU5AA28M9
MARKETING_VERSION = 2.0.0
CURRENT_PROJECT_VERSION = 25
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY =
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
// Valeurs surchargeables en ligne de commande par la CI (xcodebuild VAR=valeur).
JOLENE_ENVIRONMENT = staging
JOLENE_SUPABASE_URL =
JOLENE_SUPABASE_PUBLISHABLE_KEY =
APS_ENVIRONMENT = development
// Lot 3, T15 : DSN Sentry du projet jolene-ios, JAMAIS versionné (docs/mobile-swift/SENTRY_IOS.md). Vide : Sentry
// désactivé. Injecté en ligne de commande (xcodebuild JOLENE_SENTRY_DSN=…) : ios-native-testflight.yml depuis le secret
// facultatif SENTRY_DSN_IOS, en local par Gabrielle pour la recette du crash de test.
JOLENE_SENTRY_DSN =
