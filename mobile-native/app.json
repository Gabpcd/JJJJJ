{
  "expo": {
    "name": "Jolene · Pilote natif",
    "slug": "jolene-native-pilot",
    "version": "0.1.0",
    "scheme": "jolene-native-pilot",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.jolene.nativepilot"
    },
    "android": {
      "package": "app.jolene.nativepilot",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Jolene utilise l’appareil photo pour photographier le document que vous choisissez de transmettre.",
          "photosPermission": "Jolene utilise la photo que vous sélectionnez pour votre justificatif.",
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "enabled": false
    }
  }
}
