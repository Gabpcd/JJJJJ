+               newText, oldText, defaultAttributes, props.textAttributes, !props.multiline) ||
+        RCTIsAttributedStringEffectivelySame(
+               newText, oldText, _originalTypingAttributes, props.textAttributes, !props.multiline);
   }
 }
 
