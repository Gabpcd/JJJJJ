{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-well-known.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrat": "node scripts/check-contrat-frontend-backend.mjs",
    "preflight:mobile": "MOBILE_BUILD_PROFILE=store REQUIRE_MOBILE_SECRETS=1 node scripts/prepare-mobile-secrets.mjs",
    "preflight:mobile:dev": "MOBILE_BUILD_PROFILE=development ALLOW_NON_LIVE_STRIPE_KEY=1 REQUIRE_MOBILE_SECRETS=1 node scripts/prepare-mobile-secrets.mjs",
    "test:mobile-preflight": "node --test tests/node/prepare-mobile-secrets.node.mjs",
    "build:mobile": "npm run preflight:mobile && VITE_NATIVE_BUILD=true VITE_TURNSTILE_SITE_KEY= REQUIRE_ANDROID_APP_LINKS=1 npm run build && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "resources": "npx @capacitor/assets generate",
    "test:e2e": "npx playwright test",
    "test:escrow": "npx playwright test e2e/flows/escrow-revenus-soignant.spec.ts --project=chromium",
    "test:e2e:ui": "npx playwright test --ui",
    "screenshots:play": "node scripts/capture-google-play.mjs",
    "screenshots:play:check": "node --check scripts/capture-google-play.mjs && node scripts/capture-google-play.mjs --check",
    "screenshots:app-store": "CAPTURE_STORE=app-store node scripts/capture-google-play.mjs",
    "screenshots:app-store:check": "node --check scripts/capture-google-play.mjs && CAPTURE_STORE=app-store node scripts/capture-google-play.mjs --check",
    "test:invoicing": "vitest run tests/invoicing/",
    "test:chorus:sandbox": "vitest run tests/invoicing/chorus-submission.test.ts",
    "test:guards": "bash tests/non-regression/guards.sh",
    "test:schema": "node tests/non-regression/schema-guard.mjs",
    "test:regression:invoicing": "vitest run --config vitest.invoicing.config.ts",
    "test:regression:derivation": "vitest run src/lib/planning-derive.test.ts",
    "test:e2e:regression": "npx playwright test --project=mobile-non-regression",
    "test:regression": "npm run test:guards && npm run test:schema && npm run test:regression:invoicing && npm run test:regression:derivation && npm run test:e2e:regression"
  },
