require 'json'
require_relative 'ios_review_submission'
ROOT = File.expand_path('..', __dir__)

default_platform(:ios)

# config/mobile-release.json est scindé par plateforme depuis le lot 6
# (docs/mobile-swift/DECISIONS_LOT6.md) : « ios » (app Swift) et « android » (coquille Capacitor).
def release_config(platform)
  JSON.parse(File.read(File.join(ROOT, 'config/mobile-release.json'))).fetch(platform)
end

platform :ios do
  # Verrou : la coquille Capacitor iOS (ios/, 1.0.7 build 24) n'est plus construite ni soumise.
  # L'app iOS livrée est l'app Swift : lanes testflight_native et submit_native ci-dessous.
  desc 'Retired: the Capacitor iOS shell is no longer submitted'
  lane :submit do
    UI.user_error!('Lane retirée au lot 6 : la coquille Capacitor iOS n\'est plus soumise. ' \
      'Soumission de l\'app Swift : workflow ios-native-app-store.yml (voir docs/mobile-swift/APP_STORE.md).')
  end

  # App Swift (ios-native/), workflow ios-native-app-store.yml : soumet à la revue Apple un build
  # déjà envoyé sur TestFlight et déjà VALID. Aucun binaire n'est envoyé ici. La fiche (description,
  # captures, notes pour la revue, confidentialité, classification) reste saisie dans App Store
  # Connect ; seules les « Nouveautés » fr-FR viennent de config/mobile-release-notes-ios.txt.
  # Publication progressive sur sept jours (docs/mobile-swift/APP_STORE.md).
  desc 'Submit an existing TestFlight build of the Swift app to App Review with a phased release'
  lane :submit_native do
    release = release_config('ios')
    marketing = release.fetch('marketingVersion')
    number = ENV.fetch('IOS_NATIVE_BUILD_NUMBER')
    unless number.match?(/\A[1-9]\d{0,8}\z/) && number.to_i >= release.fetch('minimumBuildNumber') && number.to_i > 24
      UI.user_error!("Build #{number.inspect} refusé : numéro d'un build TestFlight, au moins #{release.fetch('minimumBuildNumber')}.")
    end
    unless Gem::Version.new(marketing) > Gem::Version.new('1.0.7')
      UI.user_error!("Version #{marketing} refusée : elle doit dépasser 1.0.7, la version en vente.")
    end
    automatic = { 'true' => true, 'false' => false }.fetch(ENV.fetch('IOS_NATIVE_AUTOMATIC_RELEASE')) do
      UI.user_error!('IOS_NATIVE_AUTOMATIC_RELEASE doit valoir true ou false.')
    end
    release_notes = File.read(File.join(ROOT, 'config/mobile-release-notes-ios.txt')).strip
    UI.user_error!('config/mobile-release-notes-ios.txt est vide.') if release_notes.empty?
    api = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_PRIVATE_KEY_BASE64'), is_key_content_base64: true
    )
    app = Spaceship::ConnectAPI::App.find('app.jolene')
    guard = IosReviewSubmission::Guard.new(
      gateway: IosReviewSubmission::Gateway.new(client: Spaceship::ConnectAPI, app_id: app&.id),
      marketing_version: marketing, build_number: number
    )
    # Le bloc ne s'exécute que si le build est absent d'App Store Connect : rien n'est envoyé d'ici.
    result = guard.prepare! do
      raise IosReviewSubmission::Failure, "Build #{marketing} (#{number}) absent de TestFlight : lancer d'abord ios-native-testflight.yml"
    end
    if result == :already_submitted
      UI.success('This exact Apple build is already submitted')
      next
    end
    upload_to_app_store(
      api_key: api, app_identifier: 'app.jolene', app_version: marketing,
      build_number: number, skip_binary_upload: true,
      skip_screenshots: true, skip_metadata: false,
      release_notes: { 'fr-FR' => release_notes },
      submit_for_review: true, automatic_release: automatic, phased_release: true, force: true,
      reject_if_possible: false,
      run_precheck_before_submit: false
    )
  end

  # App Swift (ios-native/), workflow ios-native-testflight.yml : envoi TestFlight interne
  # uniquement. Ni revue Apple, ni testeurs externes, ni fiche App Store : la lane ne fait
  # qu'envoyer l'IPA déjà contrôlée (docs/mobile-swift/TESTFLIGHT.md).
  desc 'Upload the Swift app IPA to TestFlight for internal testers only'
  lane :testflight_native do
    api = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'), issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_PRIVATE_KEY_BASE64'), is_key_content_base64: true
    )
    upload_to_testflight(api_key: api, app_identifier: 'app.jolene', ipa: ENV.fetch('IOS_NATIVE_IPA_PATH'),
      skip_submission: true, distribute_external: false, skip_waiting_for_build_processing: true)
  end
end

platform :android do
  desc 'Upload the production Android bundle and send changes to review'
  lane :submit do
    release = release_config('android')
    existing = google_play_track_version_codes(package_name: 'app.jolene',
      json_key: ENV.fetch('GOOGLE_PLAY_KEY_FILE'), track: 'production')
    if existing.map(&:to_s).include?(release.fetch('buildNumber').to_s)
      UI.success('This exact Android versionCode is already on the production track')
      next
    end
    upload_to_play_store(
      package_name: 'app.jolene', json_key: ENV.fetch('GOOGLE_PLAY_KEY_FILE'),
      aab: ENV.fetch('ANDROID_AAB_PATH'), track: 'production', release_status: 'completed',
      version_name: release.fetch('marketingVersion'),
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      skip_upload_changelogs: false, metadata_path: File.join(ROOT, 'fastlane/metadata/android'),
      changes_not_sent_for_review: false, rescue_changes_not_sent_for_review: false
    )
  end
end
