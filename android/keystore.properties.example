# Modèle de configuration de signature release Android.
#
# 1. Copie ce fichier en "keystore.properties" (même dossier android/) :
#       cp android/keystore.properties.example android/keystore.properties
# 2. Remplis les 4 valeurs ci-dessous avec TA keystore.
# 3. keystore.properties et le .jks sont gitignorés : ils ne partent JAMAIS sur Git.
#
# storeFile  = chemin ABSOLU vers ta keystore .jks (hors du repo)
# storePassword / keyPassword = les mots de passe choisis à la création
# keyAlias   = l'alias choisi à la création (ex. "jolene")

storeFile=/Users/TON_USER/jolene-keys/jolene-upload.jks
storePassword=TON_MOT_DE_PASSE_KEYSTORE
keyAlias=jolene
keyPassword=TON_MOT_DE_PASSE_CLE
